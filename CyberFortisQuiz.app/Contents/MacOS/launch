#!/bin/bash

# Get the path to the .app bundle's Contents directory
CONTENTS_DIR="$(cd "$(dirname "$0")/.." && pwd)"

# Check if project path is configured (set during installation)
if [ -f "$CONTENTS_DIR/project_path" ]; then
    PROJECT_PATH="$(cat "$CONTENTS_DIR/project_path")"
else
    # Fallback: assume app is in the project directory (development mode)
    PROJECT_PATH="$(cd "$(dirname "$0")/../../.." && pwd)"
fi

# Verify the project directory exists
if [ ! -d "$PROJECT_PATH" ] || [ ! -f "$PROJECT_PATH/server.js" ]; then
    osascript -e 'display alert "Project not found" message "The quiz project directory could not be found. Please reinstall the application by running ./create-desktop-shortcut.sh from the project folder." as critical'
    exit 1
fi

# Change to the project directory
cd "$PROJECT_PATH"

# Load user's shell profile to get npm/node in PATH
# This is needed because .app bundles don't inherit the shell environment
export HOME="${HOME:-/Users/$(whoami)}"
if [ -f "$HOME/.zprofile" ]; then
    source "$HOME/.zprofile" 2>/dev/null
fi
if [ -f "$HOME/.zshrc" ]; then
    source "$HOME/.zshrc" 2>/dev/null
elif [ -f "$HOME/.bash_profile" ]; then
    source "$HOME/.bash_profile" 2>/dev/null
elif [ -f "$HOME/.profile" ]; then
    source "$HOME/.profile" 2>/dev/null
elif [ -f "$HOME/.bashrc" ]; then
    source "$HOME/.bashrc" 2>/dev/null
fi

# Add common Node.js installation paths (Homebrew Intel, Homebrew Apple Silicon, nvm, volta, fnm)
export PATH="/usr/local/bin:/opt/homebrew/bin:$PATH"
[ -d "$HOME/.nvm" ] && export NVM_DIR="$HOME/.nvm" && [ -s "$NVM_DIR/nvm.sh" ] && source "$NVM_DIR/nvm.sh" 2>/dev/null
[ -d "$HOME/.volta" ] && export PATH="$HOME/.volta/bin:$PATH"
[ -d "$HOME/.fnm" ] && export PATH="$HOME/.fnm:$PATH"
[ -d "$HOME/.local/bin" ] && export PATH="$HOME/.local/bin:$PATH"

# Verify node and npm are available
if ! command -v node &> /dev/null; then
    osascript -e 'display alert "Node.js not found" message "Please install Node.js or run the app from Terminal using ./start.sh" as critical'
    exit 1
fi

# Check if node_modules exists
if [ ! -d "node_modules" ]; then
    osascript -e 'display notification "Installing dependencies..." with title "Cyber Fortis Quiz"'
    npm install
fi

# Check if database exists
if [ ! -f "quiz.db" ]; then
    osascript -e 'display notification "Initializing database..." with title "Cyber Fortis Quiz"'
    npm run init-db
fi

# Ensure database is writable (fix SQLITE_READONLY error)
if [ -f "quiz.db" ]; then
    chmod u+w "quiz.db" 2>/dev/null
fi

# Create results directory if it doesn't exist
if [ ! -d "results" ]; then
    mkdir -p results
fi

# Ensure results directory is writable
chmod u+w "results" 2>/dev/null

# Check if server is already running on port 3000
if curl -s http://127.0.0.1:3000 > /dev/null 2>&1; then
    SERVER_READY=true
else
    # Start server in background and log output for debugging
    # Use nohup and disown to fully detach the server from this script
    nohup npm start > "$PROJECT_PATH/.server.log" 2>&1 &
    SERVER_PID=$!
    disown $SERVER_PID

    # Save PID for potential cleanup later
    echo $SERVER_PID > "$PROJECT_PATH/.server.pid"

    # Wait for server to actually be ready (up to 30 seconds)
    SERVER_READY=false
    for i in {1..30}; do
        if curl -s http://127.0.0.1:3000 > /dev/null 2>&1; then
            SERVER_READY=true
            break
        fi
        # Check if server process died
        if ! kill -0 $SERVER_PID 2>/dev/null; then
            break
        fi
        sleep 1
    done
fi

# Only open browser if server is running
if [ "$SERVER_READY" = true ]; then
    # Open browser in kiosk mode (fullscreen)
    # Firefox uses -kiosk (single dash), Chrome uses --kiosk (double dash)
    if [ -d "/Applications/Firefox.app" ]; then
        # Firefox: use -kiosk flag and pass URL directly
        /Applications/Firefox.app/Contents/MacOS/firefox -kiosk "http://127.0.0.1:3000" &
    elif [ -d "/Applications/Google Chrome.app" ]; then
        open -a "Google Chrome" --args --kiosk "http://127.0.0.1:3000"
    elif [ -d "/Applications/Chromium.app" ]; then
        open -a "Chromium" --args --kiosk "http://127.0.0.1:3000"
    else
        # Safari - open URL directly (no kiosk mode available)
        open "http://127.0.0.1:3000"
    fi

    # Exit successfully - server runs independently, browser is open
    exit 0
else
    # Server failed to start - show error
    osascript -e 'display alert "Server failed to start" message "Check if Node.js is installed correctly. Try running ./start.sh from Terminal instead." as critical'
    exit 1
fi
